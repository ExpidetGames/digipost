{
  "name": "digipost",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/test/docker.mjs tests",
    "test:e2e:docker": "node scripts/test/docker.mjs e2e",
    "verify:structure": "tsx scripts/structure/verify-structure.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm verify:structure && pnpm test",
    "infra:up": "docker compose -f docker/compose.yml --project-directory . up -d --wait && docker compose -f docker/compose.yml --project-directory . run --rm minio-init",
    "infra:down": "docker compose -f docker/compose.yml --project-directory . down",
    "db:bootstrap": "node scripts/db/bootstrap-roles.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "node scripts/db/generate-custom.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:reset": "node scripts/db/reset.mjs",
    "db:studio": "drizzle-kit studio",
    "deploy:check": "node scripts/deploy/check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.74.0",
    "@vercel/functions": "^3.9.7",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scanic": "^1.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "svix": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  }
}
