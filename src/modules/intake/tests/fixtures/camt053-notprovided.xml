<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture for R2 (idempotency-key data-loss fix): every entry's own EndToEndId is
     the literal ISO 20022 placeholder "NOTPROVIDED" - the exact shape that made the old ("v1")
     idempotency key formula (`endToEndId ?? accountServicerReference ?? ... ?? ""`) collapse
     distinct transactions onto the same key, since `??` only falls through on
     null/undefined, never on a non-empty placeholder string. No real bank, account, or person
     is represented.

     Entries 1 and 2: same day, same amount, both EndToEndId=NOTPROVIDED, but DIFFERENT
     AcctSvcrRef/counterparty - the v2 composite key must tell them apart even though the old
     "most specific reference" picker would have returned "NOTPROVIDED" for both.

     Entries 3 and 4: two identical bank-fee entries (no NtryDtls/TxDtls at all, so no
     AcctSvcrRef/NtryRef/counterparty either - genuinely indistinguishable by every field this
     parser reads). These exercise the v2 occurrence-index disambiguation: even the full
     composite collides for these two, so they still need distinct keys to both survive an
     idempotent import. -->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:camt.053.001.02">
  <BkToCstmrStmt>
    <GrpHdr>
      <MsgId>MSG-2026-09-STMT-NOTPROVIDED</MsgId>
      <CreDtTm>2026-09-02T06:00:00</CreDtTm>
    </GrpHdr>
