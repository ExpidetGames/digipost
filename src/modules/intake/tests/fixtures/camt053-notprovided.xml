        </Tp>
        <Amt Ccy="EUR">90.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Dt>
          <Dt>2026-09-01</Dt>
        </Dt>
      </Bal>

      <!-- 1: incoming payment, EndToEndId is the "no reference" placeholder, AcctSvcrRef ASR-100 -->
      <Ntry>
        <NtryRef>NTRYREF-NP-100</NtryRef>
        <AcctSvcrRef>ASR-100</AcctSvcrRef>
        <Amt Ccy="EUR">50.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>
          <Cd>BOOK</Cd>
        </Sts>
        <BookgDt>
          <Dt>2026-09-01</Dt>
        </BookgDt>
        <ValDt>
          <Dt>2026-09-01</Dt>
        </ValDt>
        <BkTxCd>
          <Domn>
            <Cd>PMNT</Cd>
            <Fmly>
              <Cd>RCDT</Cd>
              <SubFmlyCd>ESCT</SubFmlyCd>
            </Fmly>
          </Domn>
        </BkTxCd>
        <NtryDtls>
          <TxDtls>
            <Refs>
              <EndToEndId>NOTPROVIDED</EndToEndId>
              <AcctSvcrRef>ASR-100</AcctSvcrRef>
            </Refs>
            <RltdPties>
              <Dbtr>
                <Nm>Testkunde Eins GmbH</Nm>
              </Dbtr>
              <DbtrAcct>
                <Id>
                  <IBAN>DE45500105172295750001</IBAN>
                </Id>
              </DbtrAcct>
            </RltdPties>
            <RmtInf>
              <Ustrd>Ueberweisung</Ustrd>
            </RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>

      <!-- 2: same day, same amount, EndToEndId also NOTPROVIDED, but a DIFFERENT AcctSvcrRef
           and counterparty - this is the exact pair the old key formula silently collapsed. -->
