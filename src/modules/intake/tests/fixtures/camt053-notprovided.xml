            <Cd>PMNT</Cd>
            <Fmly>
              <Cd>MCOP</Cd>
              <SubFmlyCd>MCOP</SubFmlyCd>
            </Fmly>
          </Domn>
        </BkTxCd>
      </Ntry>

      <!-- 4: a second bank fee, identical in every field this parser reads (same day, same
           amount, same bank transaction code, no NtryRef/AcctSvcrRef/counterparty on either) -
           genuinely indistinguishable by the full composite; only the occurrence index tells
           these two apart. -->
      <Ntry>
        <Amt Ccy="EUR">5.00</Amt>
        <CdtDbtInd>DBIT</CdtDbtInd>
        <Sts>
          <Cd>BOOK</Cd>
        </Sts>
        <BookgDt>
          <Dt>2026-09-01</Dt>
        </BookgDt>
        <ValDt>
