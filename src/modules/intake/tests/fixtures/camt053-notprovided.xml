        <NtryRef>NTRYREF-NP-101</NtryRef>
        <AcctSvcrRef>ASR-101</AcctSvcrRef>
        <Amt Ccy="EUR">50.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
