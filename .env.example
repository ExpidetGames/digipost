# Copy to .env.local (gitignored) and fill in local values (docker/compose.yml's Postgres and
# Mailpit, or your own). Production values live only in the hosting provider's dashboard,
# never in a local .env.production* file: Next would load it for every local
# `next build` / `next start` (see decisions/0008-node-version-policy.md's sibling ADRs
# and WEBAPP_TEMPLATE_SPEC.md §9 for why .env.production(.local) must never be created).

# Public origin of the app. Read at build time where inlined into client bundles
# (NEXT_PUBLIC_APP_URL) and at runtime on the server (APP_URL) for building absolute
# URLs (auth callback, emails). No trailing slash. Locally: http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Postgres via `pg`, provider-independent, see decisions/0003) -----------
# Three roles, three connection strings (decisions/0004-three-database-roles.md).
# Local values point at docker/compose.yml's Postgres service (host port 54339) and
# scripts/db/bootstrap-roles.mjs for role creation; a hosted provider gives you these as
# separate connection strings for the same three roles.
#
# app_runtime (DML only, no DDL) — the application itself: dashboard, Server Actions,
# Better Auth. Read by src/persistence/foundation/client.ts.
# Locally: postgres://app_runtime:app_runtime@localhost:54339/app
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:54339/app

# app_public (only the exact privileges unauthenticated public paths need) — used only by
# src/persistence/foundation/** and the narrow composition seam for those paths. Leave empty
# until a project actually has an unauthenticated public path that needs it.
# Locally, once needed: postgres://app_public:app_public@localhost:54339/app
DATABASE_URL_PUBLIC=postgres://app_public:app_public@localhost:54339/app

# app_owner (owns all objects, DDL) — only scripts/db/*, drizzle.config.ts. Never used at
# request time. Locally: postgres://postgres:postgres@localhost:54339/app
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:54339/app

# --- Auth (Better Auth, self-hosted, magic link only, decisions/0005) -----------------
# Signs/encrypts sessions and hashes magic-link tokens; at least 32 characters. Generate
# with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# decisions/0074: sign-up is by invitation only. Comma-separated addresses that may create an
# account without one, only for the very first admin of a fresh database. Empty afterwards.
AUTH_BOOTSTRAP_EMAILS=

# --- Mail (nodemailer over SMTP, provider-neutral) -------------------------------------
# smtp(s)://user:pass@host:port. Locally: Mailpit from docker/compose.yml (no auth needed),
# web UI at http://localhost:54344.
SMTP_URL=smtp://localhost:54345
MAIL_FROM="Digipost <no-reply@digipost.local>"

# --- Cron (Vercel Cron or any scheduler that can send a bearer token) ------------------
# Authorization: Bearer $CRON_SECRET on every src/app/api/cron/** route
# (src/platform/api-pipeline/server/cron-auth.ts). At least 32 characters. Generate with:
# openssl rand -base64 32
CRON_SECRET=

# --- Object storage (S3-compatible, private bucket, decisions/0012-object-storage.md) --
# src/platform/object-storage is the only owner of these credentials. Cloudflare R2 in
# production (endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto");
# MinIO locally and in the test stack.
#
# Endpoint URL, optional: leave empty for AWS S3 (the default endpoint for S3_REGION),
# set for MinIO/R2/other S3-compatible providers. Locally: docker/compose.yml's MinIO
# service (host port 54346).
S3_ENDPOINT=http://localhost:54346
# Any non-empty region works against MinIO; a real provider requires its actual region
# ("auto" for Cloudflare R2).
S3_REGION=us-east-1
S3_BUCKET=digipost-documents
# Locally: docker/compose.yml's MinIO root credentials (also read by its minio-init
# service to create S3_BUCKET). Never the real production credentials in this file.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Optional boolean, default false. true puts the bucket in the URL path instead of the
# host name; required for MinIO.
S3_FORCE_PATH_STYLE=true

# --- AI (Mistral OCR + chat, decisions/0016-processing-pipeline-and-ai.md) -------------
# src/platform/mistral is the only owner of MISTRAL_API_KEY. Leave empty for local
# development without a real Mistral account: the composition root then binds
# deterministic fake adapters (fake OCR text, keyword classifier) outside production, and
# the UI shows a "Testmodus: KI-Simulation aktiv" hint. docker/compose.test.yml sets
# AI_PROVIDER=fake explicitly so tests never depend on a real key or network access.
MISTRAL_API_KEY=
# "mistral" | "fake". Optional: defaults to "mistral" once MISTRAL_API_KEY is set,
# otherwise to "fake" outside production. In production, unset (no key, no explicit
# provider) fails document processing with the ai_not_configured error code rather than
# silently simulating AI output.
AI_PROVIDER=fake
# Optional, default "mistral-ocr-latest" / "mistral-small-latest" (Mistral's own model
# names) when unset.
MISTRAL_OCR_MODEL=
MISTRAL_CHAT_MODEL=

# --- Billing (src/modules/billing, decisions/0017-billing-tiers-and-packages.md) -------
# No Stripe keys exist yet (architecture brief's product decision 3): a tier change or
# package purchase on /dashboard/billing only works when this is "true" (the test-mode
# PaymentProvider adapter, unmissable "Testmodus" badge in the UI). Optional boolean,
# default false. Set to true for local development; never set to true in production
# (there is no real payment provider behind it yet - see decisions/0017's "Consequences").
BILLING_TEST_MODE=true

# --- Observability (optional, disabled when unset) -------------------------------------
# Sentry DSN for error + performance reporting (src/platform/observability). Leave unset for
# a fully inert Sentry (no instrumentation in any runtime, no source map upload step).
SENTRY_DSN=
# Sentry auth token for uploading source maps during the build. Only needed in CI/hosting,
# only once you explicitly opt a deploy into it (next.config.ts only wraps the config with
# withSentryConfig when this is set).
SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN is NOT a variable you set: next.config.ts mirrors SENTRY_DSN into
# it automatically (src/instrumentation-client.ts, the browser SDK, needs it inlined at build
# time like any NEXT_PUBLIC_* value).

# --- Deployment (WEBAPP_TEMPLATE_SPEC.md §13.4, scripts/deploy/README.md) --------------
# The commit SHA being deployed. Set ONLY per deployment by .github/workflows/deploy-production.yml
# (never locally, never in any test env) so GET /api/health can report a short version
# and the post-deploy check (scripts/deploy/check.mjs) can confirm the live build matches
# the commit it just deployed. Leave unset here.
APP_COMMIT_SHA=
